{
    "name": "@alphawolfconsulting/opaque-ts-rfc9807",
    "version": "1.0.1",
    "description": "OPAQUE: Asymmetric Password-Authenticated Key Exchange in Typescript",
    "author": "Armando Faz <armfazh@cloudflare.com>",
    "maintainers": [
        "Armando Faz <armfazh@cloudflare.com>"
    ],
    "license": "BSD-3-Clause",
    "private": false,
    "type": "module",
    "main": "./lib/src/index.js",
    "module": "./lib/src/index.js",
    "types": "./lib/src/index.d.ts",
    "files": [
        "lib/src/**/*.!(tsbuildinfo)"
    ],
    "keywords": [
        "opaque",
        "password",
        "key exchange",
        "crypto",
        "cryptography"
    ],
    "homepage": "https://github.com/alphawolfconsulting/opaque-ts-rfc9807#readme",
    "repository": "github:alphawolfconsulting/opaque-ts-rfc9807",
    "engines": {
        "node": ">=20"
    },
    "devDependencies": {
        "@eslint/js": "9.6.0",
        "@jest/globals": "^30.2.0",
        "@paralleldrive/cuid2": "^2.2.2",
        "@rollup/plugin-commonjs": "26.0.1",
        "@rollup/plugin-node-resolve": "15.2.3",
        "@types/commander": "^2.12.0",
        "@types/jest": "29.5.12",
        "@types/node": "^25.2.1",
        "commander": "^14.0.3",
        "eslint": "8.57.0",
        "eslint-config-prettier": "9.1.0",
        "eslint-plugin-functional": "^6.0.0",
        "eslint-plugin-jest": "28.6.0",
        "eslint-plugin-jest-formatting": "3.1.0",
        "eslint-plugin-prettier": "5.1.3",
        "eslint-plugin-security": "3.0.1",
        "jest": "29.7.0",
        "prettier": "3.3.2",
        "rollup": "4.22.4",
        "tsx": "^4.21.0",
        "typescript": "5.5.3",
        "typescript-eslint": "7.15.0"
    },
    "scripts": {
        "prepack": "tsc -b",
        "prepare": "tsc -b",
        "build": "tsc -b",
        "clean": "tsc -b --clean . test",
        "test": "tsc -b test && node --experimental-vm-modules ./node_modules/jest/bin/jest.js --ci --no-cache",
        "test:vectors": "tsc -b test && node --experimental-vm-modules ./node_modules/jest/bin/jest.js --testPathPattern=rfc9807.*vectors --ci --no-cache",
        "test:vectors:registration": "tsc -b test && node --experimental-vm-modules ./node_modules/jest/bin/jest.js --testPathPattern=rfc9807-registration-vectors --ci --no-cache",
        "test:vectors:authentication": "tsc -b test && node --experimental-vm-modules ./node_modules/jest/bin/jest.js --testPathPattern=rfc9807-authentication-vectors --ci --no-cache",
        "test:vectors:fake": "tsc -b test && node --experimental-vm-modules ./node_modules/jest/bin/jest.js --testPathPattern=rfc9807-fake-response-vectors --ci --no-cache",
        "lint": "eslint .",
        "format": "prettier './(src|test)/*.ts' --write",
        "filesbundle": "rollup -c"
    },
    "dependencies": {
        "@cloudflare/voprf-ts": "1.0.0",
        "@noble/curves": "^2.0.1",
        "@noble/hashes": "1.4.0",
        "purify-ts": "^2.1.0"
    }
}
